<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="MerchantConfig" type="System.Configuration.NameValueFileSectionHandler" />
  </configSections>

  <MerchantConfig>    
  <!--HTTP and JWT-->  
    <add key="authenticationType" value ="jwt"/>
    <add key="merchantID" value="testrest"/>
    <add key="sendToProduction" value="false"/>
    <add key="productionURL" value ="api.cybersource.com"/> 
    <add key="requestJsonPath" value ="..\\..\\Resource\\request.json"/>
  <!--JWT Parameters-->  
    <add key="keyAlias" value="testrest"/>
    <add key="keyPassword" value="testrest"/>    
  <!--P12 key path.-->  
    <add key="keyfilepath" value ="..\\..\\Resource\\testrest.p12"/>    
  <!--HTTP Parameters-->  
    <add key="merchantsecretKey" value="yBJxy6LjM2TmcPGu+GaJrHtkke25fPpUX+UY6/L/1tE="/>
    <add key="merchantKeyId" value="08c94330-f618-42a3-b09d-e1e43be5efda"/>
  </MerchantConfig>
  
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>

  <!--, Version=2.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089-->

  <!--<appSettings>        
    
  </appSettings>-->
</configuration>