<?xml version="1.0"?>
<package >
  <metadata>
    <id>CyberSource.Authentication</id>
    <version>0.0.0.22</version>
    <title>CyberSource.Authentication</title>
    <authors>CyberSource Corporation</authors>
    <owners>CyberSource</owners>
    <projectUrl>https://github.com/CyberSource/cybersource-rest-auth-dotnet</projectUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <description>Use this SDK to generate Authentication Headers to be sent for the Cybersource REST API Calls</description>
    <releaseNotes>Authentication SDK for CyberSource REST APIs</releaseNotes>
	  <dependencies>
	    <dependency id="jose-jwt" version="4.1.0" />
	    <dependency id="NLog" version="5.0.0" />
	    <dependency id="NUnit" version="3.10.1" />
      <dependency id="Portable.BouncyCastle" version="1.9.0" />
	  </dependencies>
  </metadata>
  <files>
		<file src="AuthenticationSdk\bin\Release\AuthenticationSdk.dll" target="lib\AuthenticationSdk.dll"/>
    </files>
</package>